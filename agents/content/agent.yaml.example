name: Content
description: YouTube scripts, short-form video, LinkedIn, carousels, content calendars, hook libraries.
telegram_bot_token_env: CONTENT_BOT_TOKEN
model: claude-sonnet-4-6
obsidian:
  vault: /path/to/your/obsidian/vault
  folders:
    - YouTube/
    - Content/
  read_only:
    - Daily Notes/
