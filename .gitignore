# Dependencies
node_modules/

# Build output
dist/

# Environment — never commit API keys
.env

# Runtime data — NEVER commit. Contains WhatsApp/Slack messages,
# session tokens, conversation logs, and database files.
store/
workspace/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Migration state — local only
migrations/.applied.json

# Logs
*.log
/tmp/rawclaw.*

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp
.wwebjs_cache/

# Personal scripts — not for sharing
scripts/waste-reminder.sh

# Personal config -- lives in RAWCLAW_CONFIG (default ~/.rawclaw)
CLAUDE.md
agents/*/agent.yaml
agents/*/CLAUDE.md
knowledge/

.next/
.turbo/
.vercel/

# Allow template/example files that are part of the repo
!agents/*/CLAUDE.md.example
!knowledge/frameworks/
!knowledge/_template/
!knowledge/client/*.example.md
!clients/_template/
!workspace/artifacts/.gitkeep
!workspace/tmp/.gitkeep
