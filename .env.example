# Business OS Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git

# ── Telegram ──────────────────────────────────────────────────────────
# Main bot token (from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=[TELEGRAM_BOT_TOKEN]

# Your Telegram chat ID (send /chatid to your bot to get this)
ALLOWED_CHAT_ID=[YOUR_TELEGRAM_CHAT_ID]

# ── Agent Bots (one per agent) ────────────────────────────────────────
# Each agent needs its own Telegram bot token
# Create bots via @BotFather, then add tokens to agent.yaml files
# SCAN_BOT_TOKEN=[SCAN_BOT_TOKEN]
# ALI_BOT_TOKEN=[ALI_BOT_TOKEN]
# LARRY_BOT_TOKEN=[LARRY_BOT_TOKEN]
# QUILLY_BOT_TOKEN=[QUILLY_BOT_TOKEN]
# CLEO_BOT_TOKEN=[CLEO_BOT_TOKEN]
# SAM_BOT_TOKEN=[SAM_BOT_TOKEN]
# OVI_BOT_TOKEN=[OVI_BOT_TOKEN]

# ── Supabase ──────────────────────────────────────────────────────────
SUPABASE_URL=[SUPABASE_URL]
SUPABASE_SERVICE_KEY=[SUPABASE_SERVICE_KEY]

# ── Google / Gemini ───────────────────────────────────────────────────
GOOGLE_API_KEY=[GOOGLE_API_KEY]

# ── Slack ─────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=[SLACK_BOT_TOKEN]
SLACK_USER_TOKEN=[SLACK_USER_TOKEN]
SLACK_SIGNING_SECRET=[SLACK_SIGNING_SECRET]
SLACK_APP_ID=[SLACK_APP_ID]

# ── Voice (optional) ──────────────────────────────────────────────────
GROQ_API_KEY=[GROQ_API_KEY]
ELEVENLABS_API_KEY=[ELEVENLABS_API_KEY]
ELEVENLABS_VOICE_ID=[ELEVENLABS_VOICE_ID]

# ── Dashboard ─────────────────────────────────────────────────────────
DASHBOARD_PORT=3141
DASHBOARD_TOKEN=[DASHBOARD_AUTH_TOKEN]
DASHBOARD_URL=[DASHBOARD_URL]

# ── Database Encryption ───────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_ENCRYPTION_KEY=[DB_ENCRYPTION_KEY]

# ── Security ──────────────────────────────────────────────────────────
# PIN lock hash (optional). Generate:
# node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PIN').digest('hex'))"
SECURITY_PIN_HASH=
IDLE_LOCK_MINUTES=0
EMERGENCY_KILL_PHRASE=[EMERGENCY_KILL_PHRASE]

# ── External Integrations ─────────────────────────────────────────────
# CRM
CLOSE_CRM_API_KEY=[CLOSE_CRM_KEY]

# Stripe
STRIPE_SECRET_KEY=[STRIPE_SECRET_KEY]
STRIPE_WEBHOOK_SECRET=[STRIPE_WEBHOOK_SECRET]

# ClickUp
CLICKUP_API_KEY=[CLICKUP_API_KEY]

# ── Config Directory ──────────────────────────────────────────────────
# Where personal CLAUDE.md and agent configs live (outside the repo)
# Default: ~/.businessos
BUSINESSOS_CONFIG=~/.businessos

# ── Context / Model ───────────────────────────────────────────────────
CONTEXT_LIMIT=1000000
AGENT_TIMEOUT_MS=900000

# ── WhatsApp (optional) ───────────────────────────────────────────────
WHATSAPP_ENABLED=false
